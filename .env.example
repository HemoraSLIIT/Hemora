# Hemora Microservices Environment Configuration
# Copy this file to .env and update values for your environment

# ===========================================
# Django Backend Configuration
# ===========================================
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Database
DB_NAME=hemoradb
DB_USER=postgres
DB_PASSWORD=hemora25
DB_HOST=postgres
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://frontend:5173,http://frontend:80

# ML/Inference
ML_SERVICE_URL=http://ml_inference:8001/api
MODEL_PATH=/app/models/
DEFAULT_MODEL=blood_disease_classifier.pth
CONFIDENCE_THRESHOLD=0.8
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,tiff

# ===========================================
# Storage Configuration
# ===========================================
STORAGE_TYPE=local
STORAGE_BASE_PATH=/app/media

# S3/Compatible Storage (if STORAGE_TYPE=s3)
# TODO: Set these for production
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=hemora-artifacts
# S3_REGION=us-east-1

# ===========================================
# ML Inference Service Configuration
# ===========================================
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8001
ML_SERVICE_DEBUG=False
ML_MODELS_DIR=/app/models
INFERENCE_TIMEOUT=300

# ===========================================
# Worker Service Configuration
# ===========================================
DJANGO_API_URL=http://backend:8000/api
DJANGO_API_KEY=
ML_SERVICE_URL=http://ml_inference:8001/api
WORKER_POLL_INTERVAL=5
WORKER_BATCH_SIZE=5
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY=300
WORKER_HEALTHCHECK_PORT=8002

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO

# ===========================================
# Frontend Configuration
# ===========================================
VITE_API_BASE_URL=http://localhost:8000/api

# ===========================================
# Development/Optional
# ===========================================
ML_DEBUG=False
